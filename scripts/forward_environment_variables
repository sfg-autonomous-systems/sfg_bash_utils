#!/usr/bin/env bash

sfg_bash_utils__forward_environment_variables() {
    local environment_file="${1}"

    local SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Forwarding environment variables."
    local END_TEXT="< Done forwarding environment variables."

    sfg_bash_utils__print_info "${START_TEXT}"

    for var in "${@:2}"; do
        # Extract variable name (before '=').
        local environment_variable=${var%%=*}
        # Extract variable value (after '=').
        local value=${var#*=}

        sfg_bash_utils__print_plain "Forwarding environment variable '${var}'."
        set_environment_variable "${environment_file}" "${environment_variable}" "${value}"
    done

    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    sfg_bash_utils__forward_environment_variables "${@}"
fi
