#!/usr/bin/env bash

sfg_bash_utils__configure_ros_domain_id() {
    local environment_file="${1}"

    local SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Configure ROS domain ID."
    local END_TEXT="< Done configuring ROS domain ID."

    sfg_bash_utils__print_info "${START_TEXT}"
    local ENVIRONMENT_VARIABLE="ROS_DOMAIN_ID"
    local value=$(sfg_bash_utils__get_environment_variable "${environment_file}" "${ENVIRONMENT_VARIABLE}")

    if [[ -n "${value}" ]]; then
        local MESSAGE="ROS domain ID '${value}' is already set. Would you like to configure a different domain ID? [y/N] "
        read -rp "${MESSAGE}" confirm

        if [[ ! "${confirm}" == y ]]; then
            sfg_bash_utils__print_info "${END_TEXT}"
            return 0
        fi
    fi

    # Ask the user for a domain ID.
    read -rp "Enter a ROS domain ID in the range [1-101] or [215-232]: " value

    # Validate input.
    if [[ -z "${value}" ]]; then
        sfg_bash_utils__print_error "Error: ROS domain ID configuration canceled."
        exit 1
    fi

    if ! [[ "${value}" =~ ^[0-9]+$ ]]; then
        sfg_bash_utils__print_error "Error: Invalid input. Please enter an integer."
        exit 1
    fi

    if ! { [[ "${value}" -ge 1 && "${value}" -le 101 ]] || [[ "${value}" -ge 215 && "${value}" -le 232 ]]; }; then
        sfg_bash_utils__print_error "Error: ROS domain ID must be between 1-101 or 215-232."
        exit 1
    fi

    # Save the chosen ROS domain ID.
    sfg_bash_utils__set_environment_variable "${environment_file}" "${ENVIRONMENT_VARIABLE}" "${value}"
    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    sfg_bash_utils__configure_ros_domain_id "${@}"
fi
