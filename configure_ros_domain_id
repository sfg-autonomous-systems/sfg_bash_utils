#!/usr/bin/env bash

sfg_bash_utils__configure_ros_domain_id() {
    local environment_file="${1}"

    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Configure ROS domain ID."
    local END_TEXT="< Done configuring ROS domain ID."

    sfg_bash_utils__print_info "${START_TEXT}"
    local ENVIRONMENT_VARIABLE="ROS_DOMAIN_ID"
    local ros_domain_id
    ros_domain_id="$(sfg_bash_utils__get_environment_variable "${environment_file}" "${ENVIRONMENT_VARIABLE}")"

    if [[ -n "${ros_domain_id}" ]]; then
        local MESSAGE="ROS domain ID '${ros_domain_id}' is already set. Would you like to configure a different domain ID? [y/N] "
        read -rp "${MESSAGE}" confirm

        if [[ ! "${confirm}" == "y" ]]; then
            sfg_bash_utils__print_info "${END_TEXT}"
            return 0
        fi
    fi

    # Ask the user for a domain ID.
    read -rp "Enter a ROS domain ID in the range [1-101] or [215-232]: " ros_domain_id

    # Validate input.
    if [[ -z "${ros_domain_id}" ]]; then
        sfg_bash_utils__print_error "Error: ROS domain ID configuration canceled."
        exit 1
    fi

    if ! [[ "${ros_domain_id}" =~ ^[0-9]+$ ]]; then
        sfg_bash_utils__print_error "Error: Invalid input. Please enter an integer."
        exit 1
    fi

    if ! { [[ "${ros_domain_id}" -ge 1 && "${ros_domain_id}" -le 101 ]] || [[ "${ros_domain_id}" -ge 215 && "${ros_domain_id}" -le 232 ]]; }; then
        sfg_bash_utils__print_error "Error: ROS domain ID must be between 1-101 or 215-232."
        exit 1
    fi

    # Save the chosen ROS domain ID.
    sfg_bash_utils__set_environment_variable "${environment_file}" "${ENVIRONMENT_VARIABLE}" "${ros_domain_id}"
    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_bash_utils__configure_ros_domain_id "${@}"
fi
