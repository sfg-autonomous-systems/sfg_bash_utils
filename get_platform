#!/usr/bin/env bash

sfg_bash_utils__get_platform() {
    if [ -f "/etc/nv_tegra_release" ]; then
        echo "nvidia-jetson"
        return
    fi

    if command -v nvidia-smi &>/dev/null; then
        echo "nvidia"
        return
    fi

    if command -v rocm-smi &>/dev/null; then
        echo "amd"
        return
    fi

    echo "generic"
}
