#!/usr/bin/env bash
sfg_bash_utils__print_color() {
    tput bold >&2
    tput setaf ${1} >&2
    sfg_bash_utils__print_plain "${2}"
    tput sgr0 >&2
}

sfg_bash_utils__print_error() {
    sfg_bash_utils__print_color 1 "${1}"
}

sfg_bash_utils__print_warning() {
    sfg_bash_utils__print_color 3 "${1}"
}

sfg_bash_utils__print_info() {
    sfg_bash_utils__print_color 2 "${1}"
}

sfg_bash_utils__print_plain() {
    echo "${1}" >&2
}
