#!/usr/bin/env bash

sfg_bash_utils__setup_ntp_client() {
    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Setting up NTP client."
    local END_TEXT="< Done setting up NTP client."

    sfg_bash_utils__print_info "${START_TEXT}"

    if ! systemctl is-enabled systemd-timesyncd.service &>"/dev/null"; then
        sfg_bash_utils__print_error "Error: NTP client setup requires service systemd-timesyncd. You need to install and enable it with 'sudo systemctl enable --now systemd-timesyncd'."
        exit 1
    fi

    local changes_made=false

    local CONFIG_FILE="/etc/systemd/timesyncd.conf"
    local NTP_SERVER
    NTP_SERVER="$(ip route | grep '^default' | awk '{print $3}')"
    local FALLBACK_NTP_SERVER="ntp.ubuntu.com"
    local SED_EXPRESSION=(
        -e '/^NTP=.*/d'
        -e '/^FallbackNTP=.*/d'
        -e "/^\[Time\]/a NTP=${NTP_SERVER}\nFallbackNTP=${FALLBACK_NTP_SERVER}"
    )

    if ! sed "${SED_EXPRESSION[@]}" "${CONFIG_FILE}" | diff -q - "${CONFIG_FILE}" >"/dev/null"; then
        sfg_bash_utils__print_plain "NTP server configuration requires changes. Updating..."
        sudo sed -i "${SED_EXPRESSION[@]}" "${CONFIG_FILE}"
        changes_made=true
    fi

    if ! timedatectl | grep -q 'NTP service: active'; then
        sfg_bash_utils__print_plain "NTP service is not active. Enabling..."
        timedatectl set-ntp true
        changes_made=true
    fi

    if [ "${changes_made}" = true ]; then
        sfg_bash_utils__print_info "Configuration changed. Restarting systemd-timesyncd service..."
        sudo systemctl restart systemd-timesyncd
    else
        sfg_bash_utils__print_plain "No changes were necessary."
    fi

    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_bash_utils__setup_ntp_client "${@}"
fi
