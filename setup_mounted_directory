#!/usr/bin/env bash

sfg_bash_utils__set_up_mounted_directory() {
    local environment_file="${1}"
    local container_workspace_directory="${2}"

    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Setting up a directory to be mounted inside the devcontainer."
    local END_TEXT="< Done setting up a directory to be mounted inside the devcontainer."

    sfg_bash_utils__print_info "${START_TEXT}"

    local local_selected_directory
    local_selected_directory="$(sfg_bash_utils__get_environment_variable "${environment_file}" "LOCAL_SELECTED_DIRECTORY")"

    if [[ ! -t 0 ]]; then
        if [[ -z "${local_selected_directory}" || ! -d "${local_selected_directory}" ]]; then
            sfg_bash_utils__print_error "Error: No terminal available for input and no valid previously selected directory to mount."
            exit 1
        fi

        sfg_bash_utils__print_plain "Using existing selected directory '${local_selected_directory}' for mounting."
        sfg_bash_utils__set_environment_variable "${environment_file}" "CONTAINER_SELECTED_DIRECTORY_MOUNT_POINT" "${container_workspace_directory}/$(basename "${local_selected_directory}")"
        sfg_bash_utils__print_info "${END_TEXT}"
        return 0
    fi

    sfg_bash_utils__print_plain "Set up a directory to be mounted inside the devcontainer."
    sfg_bash_utils__print_warning "Note that if you change the directory to be mounted, you will need to rebuild the container for the changes to take effect."

    if [[ -n "${local_selected_directory}" && -d "${local_selected_directory}" ]]; then
        local MESSAGE="The directory '${local_selected_directory}' has previously been selected for mounting. Would you like to choose a different directory? [y/N] "
        read -rp "${MESSAGE}" confirm

        if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
            sfg_bash_utils__set_environment_variable "${environment_file}" "CONTAINER_SELECTED_DIRECTORY_MOUNT_POINT" "${container_workspace_directory}/$(basename "${local_selected_directory}")"
            sfg_bash_utils__print_info "${END_TEXT}"
            return 0
        fi
    fi

    # Allow the developer to choose a directory of their choice to mount.
    read -rp "Enter a directory to mount: " local_selected_directory

    # Check if the user canceled directory selection.
    if [[ -z "${local_selected_directory}" ]]; then
        sfg_bash_utils__print_error "Error: Directory selection canceled."
        exit 1
    fi

    # Check if the provided directory exists.
    if [[ ! -d "${local_selected_directory}" ]]; then
        sfg_bash_utils__print_error "Error: The directory does not exist."
        exit 1
    fi

    # Save the selected directory in an environment variable. This will later be leveraged
    # by docker compose to mount the specified directory inside the container.
    sfg_bash_utils__set_environment_variable "${environment_file}" "LOCAL_SELECTED_DIRECTORY" "${local_selected_directory}"
    sfg_bash_utils__set_environment_variable "${environment_file}" "CONTAINER_SELECTED_DIRECTORY_MOUNT_POINT" "${container_workspace_directory}/$(basename "${local_selected_directory}")"
    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_bash_utils__set_up_mounted_directory "${@}"
fi
