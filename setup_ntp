#!/usr/bin/env bash

sfg_bash_utils__setup_ntp() {
    local environment_file="${1}"

    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Setting up NTP."
    local END_TEXT="< Done setting up NTP."

    sfg_bash_utils__print_info "${START_TEXT}"

    local ntp_daemon=""

    if systemctl is-enabled systemd-timesyncd.service &>"/dev/null"; then
        ntp_daemon="systemd-timesyncd"
    elif systemctl is-enabled chronyd.service &>"/dev/null"; then
        ntp_daemon="chronyd"
    else
        sfg_bash_utils__print_error "Error: NTP client setup requires either systemd-timesyncd or chronyd. Please install and enable one."
        exit 1
    fi

    local ENVIRONMENT_VARIABLE="NTP_SERVER"
    local ntp_server
    ntp_server="$(sfg_bash_utils__get_environment_variable "${environment_file}" "${ENVIRONMENT_VARIABLE}")"

    if [[ -n "${ntp_server}" ]]; then
        local MESSAGE="NTP server '${ntp_server}' is already set. Would you like to configure a different NTP server? [y/N] "
        read -rp "${MESSAGE}" confirm

        if [[ ! "${confirm}" == "y" ]]; then
            sfg_bash_utils__print_info "${END_TEXT}"
            return 0
        fi
    fi

    # Allow the developer to sync to an NTP server of their choice.
    read -rp "Enter the NTP server to sync with: " ntp_server

    # Check if the user canceled NTP client configuation.
    if [[ -z "${ntp_server}" ]]; then
        sfg_bash_utils__print_error "Error: NTP client configuration canceled."
        exit 1
    fi

    # Check if the ntpdate command is available.
    if command -v ntpdate &>"/dev/null"; then
        if ntpdate -q "${ntp_server}" &>"/dev/null"; then
            sfg_bash_utils__print_plain "NTP server verified successfully."
        else
            sfg_bash_utils__print_error "Error: NTP server '${ntp_server}' is not reachable or is not a valid NTP server."
            sfg_bash_utils__print_error "Please check the server address and your network connection, then try again."
            exit 1
        fi
    else
        sfg_bash_utils__print_warning "Warning: ntpdate command not found. Skipping NTP server validation."
    fi

    local changes_made=false
    local config_file=""
    local sed_expression=()

    if [[ "${ntp_daemon}" == "systemd-timesyncd" ]]; then
        config_file="/etc/systemd/timesyncd.conf"
        sed_expression=(
            -e "/^NTP=${ntp_server}/d"
            -e 's/^NTP=/#NTP=/'
            -e 's/^FallbackNTP=/#FallbackNTP=/'
            -e "/^\[Time\]/a NTP=${ntp_server}"
        )
    elif [[ "${ntp_daemon}" == "chronyd" ]]; then
        config_file="/etc/chrony.conf"

        if [[ -f "/etc/chrony/chrony.conf" ]]; then
            config_file="/etc/chrony/chrony.conf"
        fi

        sed_expression=(
            -e "/^server ${ntp_server} /d"
            -e 's/^server /#server /'
            -e 's/^pool /#pool /'
            -e 's/^sourcedir /#sourcedir /'
            -e "\$a server ${ntp_server} iburst"
        )
    fi

    if ! sed "${sed_expression[@]}" "${config_file}" | diff -q - "${config_file}" >"/dev/null"; then
        sudo sed -i "${sed_expression[@]}" "${config_file}"
        changes_made=true
    fi

    if ! timedatectl | grep -q 'NTP service: active'; then
        sudo timedatectl set-ntp true
        changes_made=true
    fi

    if [ "${changes_made}" = true ]; then
        sfg_bash_utils__print_info "Configuration changed. Restarting ${ntp_daemon} service..."
        sudo systemctl restart "${ntp_daemon}"
    else
        sfg_bash_utils__print_plain "No changes were necessary."
    fi

    sfg_bash_utils__set_environment_variable "${environment_file}" "NTP_SERVER" "${ntp_server}"
    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_bash_utils__setup_ntp "${@}"
fi
