#!/usr/bin/env bash

sfg_bash_utils__forward_user() {
    local environment_file="${1}"

    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/common"

    local START_TEXT="> Forwarding user."
    local END_TEXT="< Done forwarding user."

    sfg_bash_utils__print_info "${START_TEXT}"
    local username="${USER}"
    local user_uid
    user_uid=$(id -u "${USER}")
    local user_gid
    user_gid=$(id -g "${USER}")

    sfg_bash_utils__print_plain "Forwarding username '${username}'."
    sfg_bash_utils__set_environment_variable "${environment_file}" "LOCAL_USERNAME" "${username}"

    sfg_bash_utils__print_plain "Forwarding UID '${user_uid}'."
    sfg_bash_utils__set_environment_variable "${environment_file}" "LOCAL_USER_UID" "${user_uid}"

    sfg_bash_utils__print_plain "Forwarding GID '${user_gid}'."
    sfg_bash_utils__set_environment_variable "${environment_file}" "LOCAL_USER_GID" "${user_gid}"

    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_bash_utils__forward_user "${@}"
fi
