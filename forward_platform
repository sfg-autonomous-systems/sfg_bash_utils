#!/usr/bin/env bash

sfg_bash_utils__forward_platform() {
    local environment_file="${1}"

    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/common"
    source "${SCRIPT_DIR}/get_platform"

    local START_TEXT="> Forwarding platform."
    local END_TEXT="< Done forwarding platform."

    sfg_bash_utils__print_info "${START_TEXT}"
    local platform
    platform="$(sfg_bash_utils__get_platform)"

    sfg_bash_utils__print_plain "Detected platform '${platform}'."
    sfg_bash_utils__set_environment_variable "${environment_file}" "PLATFORM" "${platform}"
    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_bash_utils__forward_platform "${@}"
fi
